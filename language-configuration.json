{
  "comments": {
    "lineComment": "-#",
    "blockComment": ["/", ""]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(%[\\w-]+|\\.[\\w-]+|#[\\w-]+|[-](?:\\s*(?:if|unless|for|while|else)\\b|(?!\\s*#))|[:]\\w+|[/])\\b(?!.*[=!]\\s*$)(?!.*\\S.*/\\s*$)",
    "decreaseIndentPattern": "^\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*-#\\s*region\\b",
      "end": "^\\s*-#\\s*endregion\\b"
    }
  }
}
