{
  "name": "coffeehaml",
  "version": "0.1.0",
  "description": "Haml structure. CoffeeScript semantics. React runtime.",
  "type": "module",
  "license": "MIT",
  "author": "dantiel <dantiel@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantiel/CoffeeHaml.git"
  },
  "bugs": {
    "url": "https://github.com/dantiel/CoffeeHaml/issues"
  },
  "homepage": "https://github.com/dantiel/CoffeeHaml#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coffeehaml": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite-plugin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coffeehaml",
    "haml",
    "coffeescript",
    "react",
    "jsx",
    "compiler",
    "vite",
    "template-language",
    "indentation-based",
    "jsx-runtime"
  ],
  "peerDependencies": {
    "coffeescript": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "source-map": "^0.7.4"
  }
}
