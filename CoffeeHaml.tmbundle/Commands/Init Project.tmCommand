<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>uuid</key>
	<string>1B4C19CF-7E92-4B97-9D5F-2F5C4F3A8B61</string>
	<key>name</key>
	<string>Init CoffeeHaml Project</string>
	<key>command</key>
	<string>#!/bin/bash
PROJ_DIR="${TM_PROJECT_DIRECTORY:-$PWD}"

osascript - "$PROJ_DIR" &lt;&lt;'APPLESCRIPT' 2>/dev/null
on run argv
  set projDir to item 1 of argv
  tell application "Terminal"
    activate
    do script "cd " &amp; quoted form of projDir &amp; " &amp;&amp; coffeehaml init"
  end tell
end run
APPLESCRIPT</string>
	<key>input</key>
	<string>none</string>
	<key>output</key>
	<string>discard</string>
	<key>keyEquivalent</key>
	<string>^~I</string>
	<key>scope</key>
	<string>source.coffeehaml</string>
</dict>
</plist>
